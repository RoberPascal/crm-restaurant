# .env
# Конфигурация для Restaurant CRM API
# Используйте префикс CRM_ для всех переменных



CRM_COOKIE_DOMAIN=
CRM_ENVIRONMENT=development
CRM_LOG_LEVEL=debug

# URL базы данных (SQLite или PostgreSQL)
CRM_DATABASE_URL=sqlite:///./app.db

# Redis URL для кэширования и WebSocket
CRM_REDIS_URL=redis://localhost:6379/0

# Секретный ключ для JWT (должен быть >= 32 символов, сгенерируйте новый для продакшна)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
CRM_SECRET_KEY=your_secret_key_here_at_least_32_chars

# Алгоритм для JWT токенов
CRM_ALGORITHM=HS256

# Время жизни access token в минутах
CRM_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Использовать secure cookies (true для продакшна)
CRM_SECURE_COOKIES=false

# Список разрешённых CORS origins (JSON массив)
CRM_BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001", "http://127.0.0.1:3000"]

# URL Strapi API
CRM_STRAPI_PUBLIC_URL=http://localhost:1337

# Токен для доступа к Strapi API (замените на реальный)
CRM_STRAPI_API_TOKEN=your_strapi_api_token_here

# Токен Telegram бота (опционально)
CRM_TELEGRAM_BOT_TOKEN=

# Maximum Redis connections
CRM_REDIS_MAX_CONNECTIONS=10

# Maximum bookings per slot
CRM_MAX_BOOKINGS_PER_SLOT=5