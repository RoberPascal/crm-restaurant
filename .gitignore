# =====================================================
# Root .gitignore — safety net for the entire monorepo
# =====================================================

# Environment files (secrets)
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
.venv/
venv/

# Node.js
node_modules/
.next/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Logs
*.log
logs/

# Docker
docker-compose.override.yml

# Admin credentials — NEVER commit
admin-credentials.txt
*-credentials.txt
credentials.txt

# Misc scratch files
txt.txt

# app-dev/frontend and strapi-dev are excluded from this repository
app-dev/
strapi-dev/

# Credentials
admin-credentials.txt
*.credentials*
