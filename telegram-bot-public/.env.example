# Telegram Bot Public — Environment Variables
# Copy to .env and fill in your values

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_URL=https://your-domain.com
TELEGRAM_WEBHOOK_PATH=/webhook
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here
TELEGRAM_WEBAPP_URL=https://your-mini-app-url.com
TELEGRAM_WEBAPP_TEXT=Open app

POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=app
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0
REDIS_BOOKING_CHANNEL=booking_updates

ENVIRONMENT=production
LOG_LEVEL=info

REMINDER_BEFORE_BOOKING_HOURS=24
REMINDER_BEFORE_BOOKING_MINUTES=60
