# Telegram Bot Staff — Environment Variables
# Copy to .env and fill in your values

TELEGRAM_BOT_STAFF_TOKEN=your_telegram_bot_staff_token_here
TELEGRAM_STAFF_CHAT_ID=your_staff_chat_id_here
TELEGRAM_BOT_STAFF_WEBHOOK_URL=https://your-domain.com
TELEGRAM_WEBHOOK_PATH=/webhook/staff
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here

POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=app
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0
REDIS_BOOKING_CHANNEL=booking_updates

ENVIRONMENT=production
LOG_LEVEL=info

REMINDER_BEFORE_END_MINUTES=30
REMINDER_CHECK_INTERVAL_SECONDS=60
